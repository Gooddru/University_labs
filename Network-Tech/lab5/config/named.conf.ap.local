options {
    listen-on port 53 { 10.0.0.1; 127.0.0.1; };
    listen-on-v6 { none; };
    directory "/var/named";
    recursion yes;
    allow-query { 10.0.0.0/24; 127.0.0.1; };
    allow-recursion { 10.0.0.0/24; 127.0.0.1; };
    version "My Own DNS Server";
};

zone "ap.local" IN {
    type master;
    file "/var/named/ap.local.db";
    allow-transfer { none; };
    allow-update { any; };
};